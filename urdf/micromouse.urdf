<!--
  ============================================================================
  地老鼠走迷宫系统 —— 差速两轮移动机器人 URDF 模型
  课程：机器人感知与控制综合实践   学号：24031126  姓名：朱酉烨
  ============================================================================
  坐标系约定（REP-103）：x 向前、y 向左、z 向上；长度 m，质量 kg
  URDF 关键标签说明（任务书 3.1 要求）：
    link      : 连杆，机器人刚体单元，可包含 visual / collision / inertial
    joint     : 关节，描述两个 link 之间的相对位姿与运动自由度
                 type=fixed 固定、continuous 连续旋转（车轮）
    visual    : 仅用于 RViz2 / Gazebo 的几何外观，不参与物理计算
    collision : 碰撞几何，Gazebo 用它做接触检测（本模型与 visual 同尺寸）
    inertial  : 质量与 3x3 惯性张量，Gazebo 动力学用（长方体/圆柱解析解）
  ============================================================================
-->
<robot name="micromouse">

  <!-- 0. base_footprint：地面投影虚拟系，无质量无几何。
       odom -> base_footprint 的 TF 由 Gazebo 差速驱动插件发布 -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
  </joint>

  <!-- 1. 底盘 base_link：0.40 x 0.30 x 0.20 长方体，质量 2.0 kg -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.40 0.30 0.20"/></geometry>
      <material name="light_gray"><color rgba="0.80 0.82 0.86 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.40 0.30 0.20"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <!-- 长方体惯性张量 I=m/12*(b^2+c^2) 等 -->
      <inertia ixx="0.023067" ixy="0.0" ixz="0.0"
               iyy="0.034733" iyz="0.0" izz="0.041667"/>
    </inertial>
  </link>

  <!-- 2. 左驱动轮：圆柱默认轴沿 z，绕 x 转 90 度后轴沿 y，成为滚动车轮 -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
      <material name="dark"><color rgba="0.12 0.12 0.14 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.000542" ixy="0.0" ixz="0.0"
               iyy="0.001000" iyz="0.0" izz="0.000542"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0.0 0.175 -0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 3. 右驱动轮：与左轮镜像，仅 y 取负 -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
      <material name="dark"><color rgba="0.12 0.12 0.14 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.000542" ixy="0.0" ixz="0.0"
               iyy="0.001000" iyz="0.0" izz="0.000542"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0.0 -0.175 -0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 4. 后部万向支撑球轮：球底 z=-0.18 与驱动轮触地面平齐，三点支撑 -->
  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.04"/></geometry>
      <material name="dark"><color rgba="0.12 0.12 0.14 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.000032" ixy="0.0" ixz="0.0"
               iyy="0.000032" iyz="0.0" izz="0.000032"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.16 0 -0.14" rpy="0 0 0"/>
  </joint>

  <!-- 4b. 前部支撑球轮。只有后 caster 时，车体是"两轮 + 后点"的三点支撑，
       重心几乎落在轮轴上，Gazebo 中会绕 y 轴栽头，直到车头底边触地：
       arcsin(0.08/0.20) = 23.6 度。加前支撑后形成四点支撑，姿态保持水平，
       雷达扫描平面才不会被迫打向地面。 -->
  <link name="front_caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.04"/></geometry>
      <material name="dark"><color rgba="0.12 0.12 0.14 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.000032" ixy="0.0" ixz="0.0"
               iyy="0.000032" iyz="0.0" izz="0.000032"/>
    </inertial>
  </link>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_link"/>
    <origin xyz="0.16 0 -0.14" rpy="0 0 0"/>
  </joint>

  <!-- 5. 激光雷达 link：装在车顶上方，世界高度 0.38 m（车顶 0.28 m），
       扫描平面高于所有车体碰撞体，避免射线打到自身。
       不设 collision：防止 360 度射线命中雷达自身圆柱外壳 -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
      <material name="blue"><color rgba="0.10 0.35 0.85 1.0"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.000070" ixy="0.0" ixz="0.0"
               iyy="0.000070" iyz="0.0" izz="0.000125"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.10 0 0.20" rpy="0 0 0"/>
  </joint>

  <!-- ====================== Gazebo 扩展标签 ====================== -->
  <!-- 车体外观与轮胎摩擦（mu 越大越不易打滑，避免里程计严重漂移） -->
  <gazebo reference="base_link">
    <material>Gazebo/White</material>
  </gazebo>
  <gazebo reference="left_wheel_link">
    <!-- 接触刚度使用 Gazebo 默认值：kp 设成 1e6 会让 ODE 接触力数值发散，
         车体出现约 24 度的 pitch 倾斜，雷达扫描面随之打向地面/车体 -->
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="caster_link">
    <mu1>0.1</mu1><mu2>0.1</mu2>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="front_caster_link">
    <mu1>0.1</mu1><mu2>0.1</mu2>
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- 差速驱动插件：订阅 /cmd_vel，按轮速积分发布 /odom 与 odom->base_footprint TF。
       这是"基于里程计的闭环控制"的数据来源，不依赖任何 SLAM/全局定位。 -->
  <gazebo>
    <plugin name="micromouse_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>50</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.35</wheel_separation>
      <wheel_diameter>0.20</wheel_diameter>
      <wheel_torque>20.0</wheel_torque>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- 2D 激光雷达插件：360 度、360 个测距点、量程 0.12~8.0 m，发布 /scan -->
  <gazebo reference="laser_link">
    <sensor name="micromouse_lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265359</min_angle>
            <max_angle>3.14159265359</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min><max>8.0</max><resolution>0.01</resolution>
        </range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.003</stddev></noise>
      </ray>
      <plugin name="micromouse_laser_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
